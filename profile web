<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Johnson S — ECE Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --blueprint: #0F2A43;
    --blueprint-deep: #0A1F33;
    --grid: rgba(242,239,228,0.06);
    --paper: #F2EFE4;
    --paper-dim: #A9BCCB;
    --copper: #FFB454;
    --teal: #64D9C4;
    --violet: #B48CFF;
    --pink: #FF7CB4;
    --mono: 'IBM Plex Mono', monospace;
    --sans: 'IBM Plex Sans', sans-serif;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px),
      var(--blueprint);
    background-size:36px 36px, 36px 36px, cover;
    color:var(--paper);
    font-family:var(--sans);
    line-height:1.6;
    overflow-x:hidden;
    position:relative;
  }

  /* floating particle layer */
  .particles{
    position:fixed; inset:0;
    pointer-events:none;
    z-index:0;
    overflow:hidden;
  }
  .particle{
    position:absolute;
    border-radius:50%;
    opacity:0.5;
    animation:float linear infinite;
  }
  @keyframes float{
    0%{ transform:translateY(110vh) translateX(0); opacity:0; }
    10%{ opacity:0.55; }
    90%{ opacity:0.4; }
    100%{ transform:translateY(-10vh) translateX(30px); opacity:0; }
  }

  .wrap{ max-width:760px; margin:0 auto; padding:0 24px 120px; position:relative; z-index:1; }

  /* HERO */
  .hero{
    min-height:88vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    position:relative;
  }
  .trace-svg{
    position:absolute;
    top:0; left:-24px; right:-24px;
    width:calc(100% + 48px);
    height:100%;
    pointer-events:none;
  }
  .trace-path{
    fill:none;
    stroke:var(--copper);
    stroke-width:1.5;
    stroke-dasharray:900;
    stroke-dashoffset:900;
    animation:draw 2.2s ease-out forwards;
    opacity:0.55;
  }
  @keyframes draw{ to{ stroke-dashoffset:0; } }
  .node{
    fill:var(--teal);
    opacity:0;
    animation:nodefade 0.6s ease-out forwards, glow 2s ease-in-out infinite 2.5s;
  }
  @keyframes nodefade{ to{ opacity:0.9; } }
  @keyframes glow{
    0%,100%{ r:4; }
    50%{ r:6; }
  }

  .dept-tag{
    font-family:var(--mono);
    font-size:13px;
    color:var(--copper);
    letter-spacing:0.02em;
    margin-bottom:18px;
    display:flex;
    align-items:center;
    gap:8px;
    opacity:0;
    animation:riseIn 0.7s ease-out 0.2s forwards;
  }
  .pulse-dot{
    width:7px; height:7px;
    border-radius:50%;
    background:var(--teal);
    box-shadow:0 0 0 0 rgba(100,217,196,0.6);
    animation:pulse 2.4s ease-out infinite;
  }
  @keyframes pulse{
    0%{ box-shadow:0 0 0 0 rgba(100,217,196,0.5); }
    70%{ box-shadow:0 0 0 10px rgba(100,217,196,0); }
    100%{ box-shadow:0 0 0 0 rgba(100,217,196,0); }
  }
  @keyframes riseIn{
    from{ opacity:0; transform:translateY(10px); }
    to{ opacity:1; transform:translateY(0); }
  }

  h1{
    font-family:var(--mono);
    font-size:clamp(38px,7vw,58px);
    font-weight:700;
    margin:0 0 12px;
    letter-spacing:-0.01em;
    position:relative;
    z-index:1;
    background:linear-gradient(100deg, var(--copper), var(--pink) 35%, var(--violet) 60%, var(--teal) 85%, var(--copper));
    background-size:300% 100%;
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:riseIn 0.8s ease-out 0.35s forwards, hue 8s linear infinite 1.2s;
    opacity:0;
  }
  @keyframes hue{
    0%{ background-position:0% 50%; }
    100%{ background-position:300% 50%; }
  }
  .role{
    font-size:18px;
    color:var(--paper-dim);
    max-width:50ch;
    margin:0 0 32px;
    opacity:0;
    animation:riseIn 0.7s ease-out 0.55s forwards;
  }
  .hero-meta{
    display:flex;
    flex-wrap:wrap;
    gap:14px 22px;
    font-family:var(--mono);
    font-size:13px;
    opacity:0;
    animation:riseIn 0.7s ease-out 0.75s forwards;
  }
  .hero-meta a{
    color:var(--paper);
    text-decoration:none;
    border-bottom:1px solid rgba(242,239,228,0.25);
    padding-bottom:2px;
    transition:color 0.2s, border-color 0.2s;
  }
  .hero-meta a:hover{ color:var(--copper); border-color:var(--copper); }
  .hero-meta span{ color:var(--paper-dim); }

  /* SECTION HEADERS */
  section{ margin-top:88px; opacity:0; transform:translateY(18px); transition:opacity 0.7s ease, transform 0.7s ease; }
  section.visible{ opacity:1; transform:translateY(0); }
  .sec-label{
    font-family:var(--mono);
    font-size:12px;
    color:var(--teal);
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:26px;
  }
  .sec-label::after{
    content:'';
    flex:1;
    height:1px;
    background:rgba(242,239,228,0.15);
  }

  /* ABOUT */
  .about p{
    font-size:15.5px;
    color:var(--paper-dim);
    max-width:60ch;
  }
  .about strong{
    background:linear-gradient(90deg, var(--copper), var(--pink));
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    font-weight:600;
  }

  /* SKILLS */
  .skills-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:14px;
  }
  .skill-chip{
    border:1px solid rgba(242,239,228,0.18);
    border-radius:4px;
    padding:14px 16px;
    font-family:var(--mono);
    font-size:13px;
    position:relative;
    overflow:hidden;
    transition:border-color 0.25s, transform 0.25s;
  }
  .skill-chip:hover{ border-color:var(--copper); transform:translateY(-2px); }
  .skill-chip::before{
    content:'';
    position:absolute;
    left:0; top:0; bottom:0;
    width:2px;
    background:linear-gradient(180deg, var(--teal), var(--violet));
    transform:scaleY(0);
    transform-origin:bottom;
    transition:transform 0.3s ease;
  }
  .skill-chip:hover::before{ transform:scaleY(1); }
  .skill-chip small{ display:block; color:var(--paper-dim); font-size:11px; margin-top:4px; }

  /* AI PROJECTS */
  .project{
    border:1px solid rgba(242,239,228,0.15);
    border-radius:6px;
    padding:24px 26px;
    margin-bottom:18px;
    background:rgba(242,239,228,0.02);
    position:relative;
    transition:transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  .project:hover{
    transform:translateY(-4px);
    border-color:var(--teal);
    background:rgba(100,217,196,0.05);
    box-shadow:0 12px 30px -14px rgba(100,217,196,0.35);
  }
  .project-head{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:12px;
    margin-bottom:10px;
  }
  .project-head h3{
    margin:0;
    font-size:17px;
    font-family:var(--mono);
    font-weight:600;
  }
  .ai-tag{
    font-family:var(--mono);
    font-size:11px;
    color:var(--blueprint);
    background:linear-gradient(90deg, var(--teal), var(--violet));
    border-radius:3px;
    padding:2px 8px;
    white-space:nowrap;
  }
  .project p{
    margin:0 0 14px;
    color:var(--paper-dim);
    font-size:14.5px;
  }
  .stack{ display:flex; flex-wrap:wrap; gap:7px; }
  .stack span{
    font-family:var(--mono);
    font-size:11px;
    color:var(--copper);
    border:1px solid rgba(255,180,84,0.3);
    border-radius:3px;
    padding:2px 8px;
  }

  /* CONTACT */
  .contact-box{
    border:1px solid rgba(242,239,228,0.18);
    border-radius:6px;
    padding:28px 26px;
    font-family:var(--mono);
  }
  .contact-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:10px 0;
    border-bottom:1px solid rgba(242,239,228,0.08);
    font-size:14px;
  }
  .contact-row:last-child{ border-bottom:none; }
  .contact-row span:first-child{ color:var(--paper-dim); }
  .contact-row a{ color:var(--copper); text-decoration:none; transition:color 0.2s; }
  .contact-row a:hover{ color:var(--pink); text-decoration:underline; }

  footer{
    margin-top:80px;
    font-family:var(--mono);
    font-size:12px;
    color:var(--paper-dim);
    text-align:center;
  }

  @media (max-width:520px){
    .skills-grid{ grid-template-columns:1fr; }
    .project-head{ flex-direction:column; align-items:flex-start; gap:6px; }
  }
</style>
</head>
